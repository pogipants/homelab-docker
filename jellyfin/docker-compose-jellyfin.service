Create service at
/etc/systemd/system/docker-compose-jellyfin.service

Config file
[Unit]
Description=JellyFin
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/data/jellyfin
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

Start and Check status
sudo systemctl daemon-reload
sudo systemctl enable docker-compose-jellyfin.service
sudo systemctl start docker-compose-jellyfin.service
systemctl status docker-compose-jellyfin.service

It should now autostart

